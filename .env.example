# PostgreSQL (postgres:18-alpine)
POSTGRES_DB=auth_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SenhaForte
POSTGRES_PORT=5432

# AuthService
ASPNETCORE_ENVIRONMENT=Development
AUTH_SERVICE_PORT=8080
AUTH_SERVICE_HTTPS_PORT=8081
AUTH_LOGIN_URL=http://localhost:3000/login
AUTH_HTTPS_CERTS_DIR=./certs
AUTH_KESTREL_CERT_PATH=/https/aspnetapp.pfx
AUTH_KESTREL_CERT_PASSWORD=dev-cert-password

# Certificados OpenIddict (obrigatorios apenas quando ASPNETCORE_ENVIRONMENT=Production)
OPENIDDICT_SIGNING_CERT_PATH=
OPENIDDICT_SIGNING_CERT_PASSWORD=
OPENIDDICT_ENCRYPTION_CERT_PATH=
OPENIDDICT_ENCRYPTION_CERT_PASSWORD=

# OpenIddict Clients - Web Client (Clients[0])
OPENIDDICT_WEB_CLIENT_ID=web-client
OPENIDDICT_WEB_CLIENT_SECRET=dev-secret-123
OPENIDDICT_WEB_CLIENT_DISPLAY_NAME=Web Application Client
OPENIDDICT_WEB_CLIENT_REDIRECT_URI=http://localhost:3000/callback
OPENIDDICT_WEB_CLIENT_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
OPENIDDICT_WEB_CLIENT_REQUIRE_PKCE=true
